<Page x:Class="PWSW_Project_todo_calendar.Pages.AddGoalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages"
      mc:Ignorable="d"
      Title="AddTaskPage" Height="450" Width="800">
    <Grid Background="#FFF7F7F7" Margin="24">
        <Border Background="LightGray" CornerRadius="6" Padding="16" HorizontalAlignment="Center" Width="540">
            <StackPanel Orientation="Vertical">

                <TextBlock Text="TextBlock" FontSize="22" Height="28"
                           TextAlignment="Center" FontWeight="Bold"
                           Margin="0,10,0,20" />

                <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Background="LightGray">

                        <StackPanel Orientation="Vertical" Background="LightGray">
                            <TextBox x:Name="GoalName" Text="Wpisz nazwę zadania" Height="32" Margin="0,10,0,0" />
                            <TextBlock Text="Nazwa zadania" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,10">
                            <DatePicker x:Name="GoalDate" Height="32" />
                            <TextBlock Text="Termin wykonania" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,10" >
                            <RichTextBox x:Name="GoalDescr" Height="100" MinWidth="490" HorizontalAlignment="Stretch">
                                <FlowDocument>
                                    <Paragraph Margin="0">
                                        <Run Text="This is a sample RichTextBox. You can format text, insert images, and more." />
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <TextBlock Text="Opis" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,20">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="GoalCat" Height="32" Width="250" Padding="6,4" FontSize="13">
                                    <ComboBoxItem Content="Item1" IsSelected="True" />
                                    <ComboBoxItem Content="Item2" />
                                </ComboBox>

                                <TextBox Name="TextBox1" Height="25" Width="150" Margin="10,0,0,0" />
                                <Button Name="AddButton" Width="70" Height="25" Content="Dodaj"
                                        Click="AddButton_Click" />
                            </StackPanel>

                            <TextBlock Text="Kategoria" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,0,0,0">
                            <ComboBox x:Name="GoalImportance" Height="32" Width="Auto" Padding="6,4" FontSize="13">
                                <ComboBoxItem Content="0" IsSelected="True" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                            </ComboBox>

                            <TextBlock Text="Pryjorytet" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>

                        <Button Content="Dodaj cel" HorizontalAlignment="Center"
                                Width="200" Height="32" Margin="10,20,10,10" Click="AskAboutTasks"/>
                        

                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
