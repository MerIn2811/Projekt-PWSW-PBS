<Page x:Class="PWSW_Project_todo_calendar.Pages.AddGoalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages"
      mc:Ignorable="d"
      Title="AddGoalPage"
      Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Border Style="{StaticResource Card}"
                HorizontalAlignment="Center"
                Width="720"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Dodawanie celu"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Uzupełnij dane celu. Na końcu dodasz taski."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Content -->
                <Border Grid.Row="1"
                        Background="#FFF9FAFB"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- Nazwa -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Nazwa celu" Margin="2,0,0,6"/>
                                <TextBox x:Name="GoalName"
                                         Style="{StaticResource ModernTextBox}"
                                         Text=""/>
                            </StackPanel>

                            <!-- Termin -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Termin wykonania" Margin="2,0,0,6"/>
                                <DatePicker x:Name="GoalDate"
                                            Style="{StaticResource ModernDatePicker}"/>
                            </StackPanel>

                            <!-- Opis -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Opis" Margin="2,0,0,6"/>

                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">

                                    <RichTextBox x:Name="GoalDescr"
                                                 Height="140"
                                                 BorderThickness="0"
                                                 Background="Transparent">
                                        <FlowDocument>
                                            <Paragraph Margin="0">
                                                <Run Text=""/>
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </Border>

                                <TextBlock Text="Możesz wpisać krótkie szczegóły i notatki."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="2,6,0,0"/>
                            </StackPanel>

                            <!-- Kategoria -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Kategoria" Margin="2,0,0,6"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- lista kategorii -->
                                    <ComboBox x:Name="GoalCat"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- dodaj nową kategorię -->
                                    <TextBox x:Name="TextBox1"
                                             Grid.Column="2"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="36"
                                             VerticalAlignment="Center"/>

                                    <Button x:Name="AddButton"
                                            Grid.Column="4"
                                            Content="Dodaj"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="90"
                                            Click="AddButton_Click"/>
                                </Grid>

                                <TextBlock Text="Wybierz kategorię lub dodaj nową."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="2,6,0,0"/>
                            </StackPanel>

                            <!-- Priorytet -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Priorytet" Margin="2,0,0,6"/>
                                <ComboBox x:Name="GoalImportance"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="0" IsSelected="True"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                </ComboBox>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button Content="Dodaj cel i przejdź do tasków"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Width="260"
                            Click="AskAboutTasks"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
