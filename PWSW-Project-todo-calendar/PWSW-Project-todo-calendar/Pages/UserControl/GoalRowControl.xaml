<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.GoalRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    
    
    <StackPanel Orientation="Vertical">

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" Content="Goal" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="TextBlock" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="TextBlock" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="⛭" Width="25" Height="25" Click="goGoalControlClick"  />

            <!-- Strzałka zmienia się triggerem na samym ToggleButton -->
            <ToggleButton x:Name="ToggleTask"
                          Grid.Column="4"
                          Width="24" Height="24"
                          Content="▼"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Checked="ToggleTask_Checked"
                          Unchecked="ToggleTask_Unchecked">
            </ToggleButton>
        </Grid>

        <!-- Widoczność sterowana stylem Border (bez TargetName) -->
        <Border x:Name="TasksPanel"
                Margin="8,6,0,0"
                Padding="8"
                Background="#22FFFFFF"
                CornerRadius="6"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <local:TaskRowControl/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
