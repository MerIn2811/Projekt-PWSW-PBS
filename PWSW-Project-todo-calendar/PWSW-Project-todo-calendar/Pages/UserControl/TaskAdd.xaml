<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.TaskAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="*" d:DesignWidth="*">
    <Border Background="LightGray" CornerRadius="6" Padding="10" Margin="0,0,0,12">
        <StackPanel>
            <TextBox x:Name="TbName" Height="32" Margin="0,10,0,0"/>
            <TextBlock Text="Nazwa zadania" TextAlignment="Center" Margin="0,5,0,10"/>

            <DatePicker x:Name="DpDueDate" Height="32"/>
            <TextBlock Text="Termin wykonania" TextAlignment="Center" Margin="0,5,0,10"/>

            <!-- Jeśli nie musisz formatować, lepiej TextBox (łatwe pobranie) -->
            <TextBox x:Name="TbDesc" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
            <TextBlock Text="Opis" TextAlignment="Center" Margin="0,5,0,10"/>

            <ComboBox x:Name="CbPriority" Height="32" Padding="6,4" FontSize="13">
                <ComboBoxItem Content="0"/>
                <ComboBoxItem Content="1" IsSelected="True"/>
                <ComboBoxItem Content="2"/>
            </ComboBox>
            <TextBlock Text="Priorytet" TextAlignment="Center" Margin="0,5,0,0"/>

            <Button x:Name="deleteBtn" Content="Usuń" Width="200" Height="32" Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="Remove_Click"/>
        </StackPanel>
    </Border>
</UserControl>
