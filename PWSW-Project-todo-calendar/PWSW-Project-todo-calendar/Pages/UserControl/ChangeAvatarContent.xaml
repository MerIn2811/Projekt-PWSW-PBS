<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.ChangeAvatarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel HorizontalAlignment="Stretch">
        <Border x:Name="AvatarCircle"
                Width="96" Height="96"
                CornerRadius="48"
                BorderBrush="#DDD" BorderThickness="1"
                Margin="0,0,0,12">
            <Border.Background>
                <ImageBrush x:Name="AvatarBrush"
                            Stretch="UniformToFill"
                            ImageSource="/../Assets/Images/basicUser.png"/>
            </Border.Background>
        </Border>

        <Button Content="Wybierz obraz"
                Width="160"
                Click="ChooseAvatar_Click"/>
    </StackPanel>
</UserControl>
