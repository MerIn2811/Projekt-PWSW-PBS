<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.ChangeGoalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= FORMULARZ ================= -->
        <StackPanel Grid.Row="0">

            <!-- Nazwa -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Nazwa celu" Margin="2,0,0,6"/>
                <TextBox x:Name="GoalNameBox"
                         Style="{StaticResource ModernTextBox}"/>
            </StackPanel>

            <!-- Termin -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Termin" Margin="2,0,0,6"/>
                <DatePicker x:Name="GoalDatePicker"
                            Style="{StaticResource ModernDatePicker}"/>
            </StackPanel>

            <!-- Opis -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Opis" Margin="2,0,0,6"/>
                <TextBox x:Name="GoalDescBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Krótki opis celu lub notatka."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="2,6,0,0"/>
            </StackPanel>

            <!-- Kategoria -->
            <StackPanel Margin="0,0,0,0">
                <TextBlock Text="Kategoria" Margin="2,0,0,6"/>
                <ComboBox x:Name="GoalCategoryBox"
                          Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Item1" IsSelected="True"/>
                    <ComboBoxItem Content="Item2"/>
                </ComboBox>
            </StackPanel>

        </StackPanel>

        <!-- ================= AKCJE DODATKOWE ================= -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                Background="#FFF9FAFB"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Dodaj / edytuj taski"
                        Style="{StaticResource SecondaryButton}"
                        Height="38"
                        Width="200"
                        Click="GoToAdTask"/>
            </StackPanel>
        </Border>

        <!-- ================= USUWANIE ================= -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Usunięcie celu spowoduje usunięcie wszystkich powiązanych tasków."
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Usuń cel"
                    Height="40"
                    Width="140"
                    Margin="12,0,0,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteGoal"/>
        </Grid>

    </Grid>
</UserControl>
