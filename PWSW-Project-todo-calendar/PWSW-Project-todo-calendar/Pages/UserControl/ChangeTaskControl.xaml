<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.ChangeTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Formularz -->
        <StackPanel Grid.Row="0">

            <!-- Nazwa -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Nazwa zadania" Margin="2,0,0,6"/>
                <TextBox x:Name="TaskNameBox"
                         Style="{StaticResource ModernTextBox}"/>
            </StackPanel>

            <!-- Data -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Termin" Margin="2,0,0,6"/>
                <DatePicker x:Name="TaskDatePicker"
                            Style="{StaticResource ModernDatePicker}"/>
            </StackPanel>

            <!-- Opis -->
            <StackPanel Margin="0,0,0,0">
                <TextBlock Text="Opis" Margin="2,0,0,6"/>
                <TextBox x:Name="TaskDescBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Zaktualizuj szczegóły zadania."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="2,6,0,0"/>
            </StackPanel>

        </StackPanel>

        <!-- Akcje -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Usunięcie zadania jest nieodwracalne."
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Usuń zadanie"
                    Height="40"
                    Width="150"
                    Margin="12,0,0,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteTask"/>
        </Grid>
    </Grid>
</UserControl>
