<UserControl x:Class="PWSW_Project_todo_calendar.Pages.UserControl.ChangePasswordContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="520">

    <StackPanel>

        <TextBlock Text="Zmiana hasła"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>

        <TextBlock Text="Wprowadź aktualne i nowe hasło, a następnie wpisz kod z maila."
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,16"/>

        <!-- Aktualne hasło -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Aktualne hasło" Margin="2,0,0,6"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Style="{StaticResource ModernPasswordBox}"/>
        </StackPanel>

        <!-- Nowe hasło -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Nowe hasło" Margin="2,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Style="{StaticResource ModernPasswordBox}"/>
        </StackPanel>

        <!-- Kod -->
        <StackPanel Margin="0,0,0,0">
            <TextBlock Text="Kod z maila" Margin="2,0,0,6"/>
            <TextBox x:Name="EmailCodeBox"
                     Style="{StaticResource ModernTextBox}"/>
            <TextBlock Text="Kod powinien trafić na Twoją skrzynkę w ciągu kilku chwil."
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="2,6,0,0"/>
        </StackPanel>

    </StackPanel>
</UserControl>