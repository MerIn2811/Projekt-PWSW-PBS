<Page x:Class="PWSW_Project_todo_calendar.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      Title="StatisticsPage" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <TextBlock Text="Statystyka w wybranym miesiącu"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,12"
                       HorizontalAlignment="Center" />
            <Border Background="#00FFFFFF" CornerRadius="6" Padding="0" Margin="90,0,90,0">
                <StackPanel Orientation="Vertical">
                    <Viewbox Stretch="Uniform">
                        <Calendar/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Podsumowanie"
                               TextAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <lvc:PieChart x:Name="StatsPieSmall"
                                  Height="150"
                                  LegendPosition="Right"
                                  InitialRotation="-90"/>
                    <TextBlock x:Name="DesignerPlaceholderSmall"
                               Text="(Podgląd wykresu w runtime)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Text="Statystyka w wybranym okresie"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,12"
                       HorizontalAlignment="Center" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Od" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1" Margin="10,0,10,0"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Do" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1" Margin="10,0,10,0"/>
                </Grid>
            </Grid>
            <Border CornerRadius="10" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Podsumowanie"
                               TextAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <lvc:PieChart x:Name="StatsPie"
                                  Height="260"
                                  LegendPosition="Right"
                                  InitialRotation="-90"/>
                    <TextBlock x:Name="DesignerPlaceholder"
                               Text="(Podgląd wykresu w runtime)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
</Page>
