<Page x:Class="PWSW_Project_todo_calendar.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:userControl="clr-namespace:PWSW_Project_todo_calendar.Pages.UserControl"
      mc:Ignorable="d"
      Title="HomePage"
      Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEWA: lista z filtrami ================= -->
        <Border Grid.Column="0"
                Style="{DynamicResource Card}"
                Margin="0,0,12,0"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Zadania"
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Filtruj po dacie i kategorii."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Zakres dat -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Od" Margin="2,0,0,6"/>
                        <DatePicker x:Name="DateFrom"
                                    Style="{DynamicResource ModernDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Do" Margin="2,0,0,6"/>
                        <DatePicker x:Name="DateTo"
                                    Style="{DynamicResource ModernDatePicker}"/>
                    </StackPanel>
                </Grid>

                <!-- Kategoria -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Kategoria" Margin="2,0,0,6" />
                    <ComboBox x:Name="Categorie"
                              Style="{DynamicResource ModernComboBox}"/>
                </StackPanel>

                <!-- Przyciski -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Szukaj"
                            x:Name="FilterButton"
                            Style="{DynamicResource PrimaryButton}"
                            Height="40"
                            Click="FilterButton_OnClick"/>

                    <Button Grid.Column="2"
                            Content="Wyczyść"
                            x:Name="ClearButton"
                            Style="{DynamicResource SecondaryButton}"
                            Height="40"
                            Click="ClearButton_OnClick"/>
                </Grid>

                <!-- Lista celów -->
                <Border Grid.Row="4"
                        Background="#FFF9FAFB"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Goals" Orientation="Vertical">
                            <!-- <userControl:GoalRowControl/> -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

        <!-- ================= ŚRODEK: kalendarz + statystyki ================= -->
        <Border Grid.Column="1"
                Style="{DynamicResource Card}"
                Margin="0,0,12,0"
                Padding="16">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Kalendarz"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Wybierz dzień, aby zobaczyć cele."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Kalendarz w ramce -->
                    <Border Grid.Row="1"
                            Background="#FFF9FAFB"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">

                        <Viewbox Stretch="Uniform">
                            <Calendar x:Name="Calendar"
                                      SelectionMode="SingleDate"
                                      SelectedDatesChanged="Calendar_OnSelectedDatesChanged"/>
                        </Viewbox>
                    </Border>

                    <Button Grid.Row="2"
                            Content="Więcej statystyk"
                            Style="{DynamicResource SecondaryButton}"
                            Height="40"
                            Width="180"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Click="GoToStats"/>

                    <!-- Wykres w pod-karcie -->
                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">

                        <StackPanel>
                            <TextBlock Text="Podsumowanie"
                                       TextAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <lvc:PieChart x:Name="StatsPieHome"
                                          Height="220"
                                          LegendPosition="Top"
                                          InitialRotation="-90"/>

                            <TextBlock x:Name="DesignerPlaceholderHome"
                                       Text="(Podgląd wykresu w runtime)"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                </Grid>
                </ScrollViewer>
        </Border>

        <!-- ================= PRAWA: cele na dzień ================= -->
        <Border Grid.Column="2"
                Style="{DynamicResource Card}"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Twój dzień"
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Lista celów dla wybranego dnia."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#FFF9FAFB"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GoalsByDay" Orientation="Vertical">
                            <!-- <userControl:GoalRowControl/> -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Page>
