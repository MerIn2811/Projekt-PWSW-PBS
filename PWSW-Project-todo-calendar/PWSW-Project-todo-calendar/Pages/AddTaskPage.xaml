<Page x:Class="PWSW_Project_todo_calendar.Pages.AddTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PWSW_Project_todo_calendar.Pages"
      mc:Ignorable="d"
      Title="AddTaskPage" Height="450" Width="800">
    <Grid Background="#FFF7F7F7" Margin="24">
        <Border Background="LightGray" CornerRadius="6" Padding="16" HorizontalAlignment="Center" Width="540">
            <StackPanel Orientation="Vertical">

                <TextBlock Text="TextBlock" FontSize="22" Height="28"
                           TextAlignment="Center" FontWeight="Bold"
                           Margin="0,10,0,20" />

                <ScrollViewer Height="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Background="LightGray">

                        <StackPanel Orientation="Vertical" Background="LightGray">
                            <TextBox Text="Wpisz nazwę zadania" Height="32" Margin="0,10,0,0" />
                            <TextBlock Text="Nazwa zadania" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,10">
                            <DatePicker Height="32" />
                            <TextBlock Text="Termin wykonania" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,10" >
                            <RichTextBox Height="100">
                                <FlowDocument>
                                    <Paragraph>
                                        <Run Text="This is a sample RichTextBox. You can format text, insert images, and more." />
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <TextBlock Text="Opis" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,5,0,20">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Name="ComboBox1" Height="32" Width="250" Padding="6,4" FontSize="13">
                                    <ComboBoxItem Content="Item1" IsSelected="True" />
                                    <ComboBoxItem Content="Item2" />
                                </ComboBox>

                                <TextBox Name="TextBox1" Height="25" Width="150" Margin="10,0,0,0" />
                                <Button Name="AddButton" Width="70" Height="25" Content="Dodaj"
                                        Click="AddButton_Click" />
                            </StackPanel>

                            <TextBlock Text="Termin wykonania" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,10" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Background="LightGray" Margin="0,0,0,0">
                            <ComboBox Name="ComboBoxPriority" Height="32" Width="Auto" Padding="6,4" FontSize="13">
                                <ComboBoxItem Content="Item1" IsSelected="True" />
                                <ComboBoxItem Content="Item2" />
                            </ComboBox>

                            <TextBlock Text="Pryjorytet" FontSize="14" Height="24"
                                       TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>

                        <Button Content="Button" HorizontalAlignment="Center"
                                Width="200" Height="32" Margin="0,20,0,10" />

                        <ToggleButton x:Name="TogglePopupButton"
                                      Content="Pokaż popup"
                                      Width="200" Height="32"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>

                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Run Text="Is button toggled? " />
                            <Run Text="{Binding IsChecked, ElementName=TogglePopupButton}" />
                        </TextBlock>

                        <Popup Name="myPopup" IsOpen="{Binding IsChecked, ElementName=TogglePopupButton}"
                               Placement="MousePoint">
                            <Border BorderThickness="1" Background="White">
                                <TextBlock Name="myPopupText" Foreground="Blue" Padding="30">
                                    Popup Text
                                </TextBlock>
                            </Border>
                        </Popup>

                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
