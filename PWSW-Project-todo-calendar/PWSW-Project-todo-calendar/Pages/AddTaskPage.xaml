<Page x:Class="PWSW_Project_todo_calendar.Pages.AddTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="AddTaskPage"
      Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Border Style="{StaticResource Card}"
                HorizontalAlignment="Center"
                Width="620"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Dodawanie zadań"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Dodaj jeden lub więcej tasków do celu."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Content -->
                <Border Grid.Row="1"
                        Background="#FFF9FAFB"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>
                            <!-- tu dynamicznie wrzucasz TaskAdd -->
                            <StackPanel x:Name="TasksContainer" Orientation="Vertical"/>

                            <!-- Add button -->
                            <Button Content="+"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="44"
                                    Height="44"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,8"
                                    Click="AddTask_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Text="Dodaj kolejny task"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button Content="Zakończ dodawanie"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Width="220"
                            Click="Finish_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
