<Page x:Class="PWSW_Project_todo_calendar.Pages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      Title="MenuPage"
      Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <!-- Główna karta -->
        <Border Style="{StaticResource Card}"
                MaxWidth="980"
                HorizontalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Ustawienia"
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Dostosuj wygląd aplikacji, cele i opcje użytkownika."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Dwie kolumny: VIDEO / CELE -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- VIDEO -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="VIDEO"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,14"/>

                            <!-- Rozdzielczość -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rozdzielczość" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Item1" IsSelected="True"/>
                                    <ComboBoxItem Content="Item2"/>
                                </ComboBox>
                            </Grid>

                            <!-- Kolor tła -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kolor tła" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46"
                                                      Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                            <!-- Kolor tekstu -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kolor tekstu" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgTextPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46"
                                                      Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                            <!-- Czcionki -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Czcionka tekstu" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Item1" IsSelected="True"/>
                                    <ComboBoxItem Content="Item2"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Czcionka nagłówków" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Item1" IsSelected="True"/>
                                    <ComboBoxItem Content="Item2"/>
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- CELE -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="CELE"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,14"/>

                            <!-- Dodaj kategorię -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Dodaj kategorię" VerticalAlignment="Center"/>

                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Name="TextBox1"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <Button Name="AddButton"
                                            Grid.Column="2"
                                            Content="Dodaj"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="90"
                                            Click="AddButton_Click"/>
                                </Grid>
                            </Grid>

                            <!-- Kolor skończonego zadania -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Kolor skończonego zadania" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgGoalPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46"
                                                      Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                            <!-- Kolory priorytetu -->
                            <TextBlock Text="Kolor priorytetu"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,6,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ważne" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgGoalPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46" Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Średnie" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgGoalPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46" Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Niskie" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="44" Height="34"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Background="{Binding ElementName=BgGoalPreview, Path=Fill}"
                                            Margin="0,0,10,0"/>
                                    <xctk:ColorPicker Width="46" Height="34"
                                                      ShowDropDownButton="False"
                                                      UsingAlphaChannel="False"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Dół: Zapis + opcje użytkownika -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Zapis -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <Button Content="Zapisz zmiany"
                                Style="{StaticResource PrimaryButton}"
                                Width="160"
                                Height="40"/>
                        <TextBlock Text="Zapisuje zmiany wyglądu i ustawień."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="2,10,0,0"/>
                    </StackPanel>

                    <!-- Opcje użytkownika -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Opcje użytkownika"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Linki -->
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <Button Content="Zmień hasło"
                                            Style="{StaticResource LinkButton}"
                                            Click="GoPassword_Click"/>
                                    <Button Content="Zmień obraz użytkownika"
                                            Style="{StaticResource LinkButton}"
                                            Margin="0,8,0,0"
                                            Click="GoAvatar_Click"/>
                                </StackPanel>

                                <!-- Profil -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Center">
                                    <Border Width="72" Height="72"
                                            CornerRadius="36"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                           >
                                        <Border.Background>
                                            <ImageBrush x:Name="AvatarImage"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <TextBlock Text="Username"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0"
                                               TextAlignment="Center"/>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
