<Window x:Class="PWSW_Project_todo_calendar.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja" Width="420" Height="600"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#FF2563EB"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Rejestracja" FontSize="20" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Email" />
            <TextBox x:Name="MailBox" Height="28"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Login" />
            <TextBox x:Name="UsernameBox" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Hasło" />
            <PasswordBox x:Name="PasswordBox" Height="28"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="Hasło" />
            <PasswordBox x:Name="PasswordBoxAgain" Height="28"/>
        </StackPanel>

        <Button Grid.Row="6" Content="Zarejestruj się" Height="34" Margin="0,16,0,16"
                VerticalAlignment="Top"
                Click="Register_Click"/>
        <Grid Grid.Row="5" Height="64" Margin="0,16,0,16" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="ImageCircle"
                    Width="60" Height="60"
                    CornerRadius="48"
                    BorderBrush="#DDD" BorderThickness="1"
                    Margin="0,0,20,0">
                <Border.Background>
                    <ImageBrush x:Name="AvatarBrush"
                                Stretch="UniformToFill"
                                ImageSource="/../Assets/Images/basicUser.png"/>
                </Border.Background>
            </Border>

            <Button Grid.Column="1" Content="Wybierz obraz"
                    Width="160" Height="30" Click="ChooseImage_Click"/>
        </Grid>
        <Grid Grid.Row="7" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Masz już konto?" VerticalAlignment="Center" Margin="0,0,10,0"></TextBlock>
            <Button Grid.Column="1" Content="Zaloguj się!" Style="{StaticResource LinkButton }" Click="Login_Window_Click"  />
        </Grid>
        
    </Grid>
</Window>