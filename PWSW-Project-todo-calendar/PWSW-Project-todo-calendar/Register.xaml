<Window x:Class="PWSW_Project_todo_calendar.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja"
        Width="520" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets\Images\checklist.png">

    <Grid Margin="24">
        <Border Style="{StaticResource Card}"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Rejestracja"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Utwórz konto i wybierz avatar."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Avatar -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            CornerRadius="32"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <Border.Background>
                            <ImageBrush x:Name="AvatarBrush"
                                        Stretch="UniformToFill"
                                        ImageSource="/../Assets/Images/basicUser.png"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Avatar"
                                   FontWeight="SemiBold"/>
                        <Button Content="Wybierz obraz"
                                Style="{StaticResource SecondaryButton}"
                                Width="160"
                                Margin="0,8,0,0"
                                Click="ChooseImage_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Email -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Email" Margin="0,0,0,6"/>
                    <TextBox x:Name="MailBox"
                             Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Login" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock Text="Hasło" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"/>
                </StackPanel>

                <!-- Password again -->
                <StackPanel Grid.Row="5" Margin="0,0,0,18">
                    <TextBlock Text="Powtórz hasło" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBoxAgain"
                                 Style="{StaticResource ModernPasswordBox}"/>
                </StackPanel>

                <!-- Footer buttons -->
                <StackPanel Grid.Row="6" Orientation="Vertical">

                    <Button Content="Zarejestruj się"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            Click="Register_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <TextBlock Text="Masz już konto?"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button Content="Zaloguj się"
                                Style="{StaticResource LinkButton}"
                                Click="Login_Window_Click"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
