<Window x:Class="PWSW_Project_todo_calendar.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets\Images\checklist.png">

    <Grid Margin="24">
        <Border Style="{StaticResource Card}"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Zaloguj się"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Wpisz login i hasło, aby przejść dalej."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Login" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="Hasło" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="3" Orientation="Vertical">
                    <Button Content="Zaloguj"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            Click="Login_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <TextBlock Text="Nie masz konta?"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button Content="Zarejestruj się"
                                Style="{StaticResource LinkButton}"
                                Click="Register_Click"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
