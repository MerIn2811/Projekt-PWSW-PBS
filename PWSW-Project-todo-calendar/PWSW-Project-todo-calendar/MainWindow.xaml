<Window x:Class="PWSW_Project_todo_calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Calendar"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets\Images\checklist.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="16,12,16,10"
                Padding="12"
                CornerRadius="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEWA STRONA: nawigacja -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dodaj cel"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="AddGoal_Click"
                            Width="150px"/>

                    <Button Content="Strona główna"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="Home_Click"
                            Width="150px"/>

                    <Button Content="Menu"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="Menu_Click"
                            Width="150px"/>
                    
                </StackPanel>

                <!-- PRAWA STRONA: user -->
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <Button Content="Wyloguj"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            Click="Logout_Click"
                            Width="150px"/>

                    <Border x:Name="AvatarCircle"
                            Width="40" Height="40"
                            CornerRadius="48"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush x:Name="AvatarBrush"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock x:Name="Username"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               Margin="16,0,16,16"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource BgBrush}"/>
    </Grid>
</Window>
