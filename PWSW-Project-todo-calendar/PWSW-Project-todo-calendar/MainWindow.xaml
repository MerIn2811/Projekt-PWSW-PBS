<Window x:Class="PWSW_Project_todo_calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Calendar" Width="1500" Height="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU STAŁE -->
        <Grid Grid.Row="0" Background="#FFF0F0F0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Dodaj Cel"
                    Margin="24,16,0,16" Width="110" Height="32"
                    Click="AddGoal_Click"/>

            <Button Grid.Column="1" Content="Strona główna"
                    Margin="12,16,0,16" Width="120" Height="32"
                    Click="Home_Click"/>

            <Button Grid.Column="2" Content="Menu"
                    Margin="12,16,0,16" Width="88" Height="32"
                    Click="Menu_Click"/>

            <Button Grid.Column="3" Content="Button"
                    Margin="12,16,0,16" Width="88" Height="32"/>

            
            <Grid Grid.Column="5" HorizontalAlignment="Center" Margin="0,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="Wyloguj się"
                        Margin="0,0,20,0" Width="110" Height="32"
                        Click="Logout_Click"/>
                
                <Border Grid.Column="1" x:Name="AvatarCircle"
                        Width="40" Height="40"
                        CornerRadius="48"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush x:Name="AvatarBrush"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                    </Border>
                <TextBlock Grid.Column="2"
                           x:Name="Username"
                           Margin="10,0,0,0"
                            VerticalAlignment="Center"/>
            </Grid>
            
        </Grid>

        <!-- TU ŁADUJESZ PAGES -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>