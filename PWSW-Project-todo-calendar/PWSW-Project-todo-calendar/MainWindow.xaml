<Window x:Class="PWSW_Project_todo_calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Calendar" Width="900" Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU STAŁE -->
        <Grid Grid.Row="0" Background="#FFF0F0F0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Dodaj Cel"
                    Margin="24,16,0,16" Width="110" Height="32"
                    Click="AddGoal_Click"/>

            <Button Grid.Column="1" Content="Strona główna"
                    Margin="12,16,0,16" Width="120" Height="32"
                    Click="Home_Click"/>

            <Button Grid.Column="2" Content="Menu"
                    Margin="12,16,0,16" Width="88" Height="32"
                    Click="Menu_Click"/>

            <Button Grid.Column="3" Content="Button"
                    Margin="12,16,0,16" Width="88" Height="32"/>

            <Image Grid.Column="5"
                   Source="https://userware-xaml-designer-backend-api.azurewebsites.net/images/logo.png"
                   Margin="0,8,24,8" Width="136" Height="56"
                   HorizontalAlignment="Right"/>
        </Grid>

        <!-- TU ŁADUJESZ PAGES -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>